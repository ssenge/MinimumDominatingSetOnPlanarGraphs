/-! ### The six-coin exponent is within `10⁻³` of the best -/

/-- The planar per-level fraction of Theorem `thm:planar`. -/
noncomputable def phiP (p : ℝ) : ℝ := (1 - p) * (3 - 2 * (1 - p) ^ 3 - (1 - p) ^ 6) / 9

/-- For every `p ≤ 1`, the fraction is at most `17182419/100000000`. -/
theorem phiP_le {p : ℝ} (hp1 : p ≤ 1) : phiP p ≤ (17182419 / 100000000 : ℝ) := by
  unfold phiP
  set s := 1 - p with hs
  have hs0 : 0 ≤ s := by linarith
  have hh : 0 ≤ (2862153912233996992401 / 781250000000000000000 : ℝ) * s ^ 1 + (12461517742670699 / 3906250000000000 : ℝ) * s ^ 2 + (83565828603 / 62500000000 : ℝ) * s ^ 3 + (166899 / 125000 : ℝ) * s ^ 4 + (1 : ℝ) * s ^ 5 := by positivity
  nlinarith [mul_nonneg (sq_nonneg (s - (166899 / 250000 : ℝ))) hh, sq_nonneg (s - (166899 / 250000 : ℝ) + (-365121497964447089309319931 / 564738363926066864034734499000000 : ℝ))]

/-- A lower bound on the exponent for the fraction `17182419/100000000`. -/
theorem kappa_phiP_max : (3642 / 625 : ℝ) < kappa (1 - (17182419 / 100000000 : ℝ)) := by
  have hq : (1 - (17182419 / 100000000 : ℝ)) = ((82817581 : ℕ) : ℝ) / ((100000000 : ℕ) : ℝ) := by norm_num
  have h := lt_kappa_nat (q := 1 - (17182419 / 100000000 : ℝ)) 100000000 82817581 3642 625 (by norm_num) (by norm_num) hq
    (by norm_num) (by decide +kernel)
  exact_mod_cast h

/-- An upper bound on the six-coin exponent. -/
theorem kappa_six_coins_hi : kappa (1 - phiP (21 / 64)) < (58279 / 10000 : ℝ) := by
  have hq : (1 - phiP (21 / 64)) = ((3642429005643 : ℕ) : ℝ) / ((4398046511104 : ℕ) : ℝ) := by norm_num [phiP]
  have h := kappa_lt_nat (q := 1 - phiP (21 / 64)) 4398046511104 3642429005643 58279 10000 (by norm_num) (by norm_num) hq
    (by norm_num) (by decide +kernel)
  exact_mod_cast h

/-- **The six-coin exponent is within `10⁻³` of the best.** For every `p ≤ 1` with a positive
fraction, the exponent at `p = 21/64` exceeds the exponent at `p` by less than `10⁻³`. -/
theorem six_coins_near_best {p : ℝ} (hp1 : p ≤ 1) (hpos : 0 < phiP p) :
    kappa (1 - phiP (21 / 64)) < kappa (1 - phiP p) + 1 / 1000 := by
  have hM := phiP_le hp1
  have h1 := kappa_mono (q := 1 - (17182419 / 100000000 : ℝ)) (q' := 1 - phiP p) (by norm_num) (by linarith)
    (by linarith)
  have h2 := kappa_phiP_max
  have h3 := kappa_six_coins_hi
  linarith

